#include <windows.h>
#include "@DRBC_SRC_POSIX@/src/ui/resource.h"

IDI_APP ICON "@DRBC_SRC_POSIX@/assets/app.ico"

1 24 "@DRBC_SRC_POSIX@/src/ui/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @DRBC_RC_VERSION@
 PRODUCTVERSION @DRBC_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DeltaHelpers"
            VALUE "FileDescription", "DRBackupCreator (Win32 GUI port)"
            VALUE "FileVersion", "@DRBC_RC_VERSION_STR@"
            VALUE "InternalName", "drbc"
            VALUE "LegalCopyright", "GPL-3.0 - Original project by DeltaHelpers"
            VALUE "OriginalFilename", "drbc.exe"
            VALUE "ProductName", "DRBackupCreator"
            VALUE "ProductVersion", "@DRBC_RC_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
