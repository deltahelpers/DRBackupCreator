#include <windows.h>
#include "resource.h"

IDI_APP ICON "../../assets/app.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DeltaHelpers"
            VALUE "FileDescription", "DRBackupCreator (Win32 GUI port)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "drbc"
            VALUE "LegalCopyright", "GPL-3.0 - Original project by DeltaHelpers"
            VALUE "OriginalFilename", "drbc.exe"
            VALUE "ProductName", "DRBackupCreator"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
